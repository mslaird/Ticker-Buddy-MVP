# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Sentry Error Monitoring (Optional but Recommended)
# Get your DSN from https://sentry.io/settings/projects/ticker-buddy/keys/
VITE_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project
VITE_SENTRY_ENABLE_DEV=false  # Set to 'true' to test Sentry in development
VITE_APP_VERSION=1.0.0  # Increment with each release
