# Financial Modeling Prep API key.
# Note: the VITE_ prefix means this value is inlined into the client bundle at
# build time and is readable by anyone in devtools. The Express proxy in
# server/ exists to keep the key server-side; wiring the frontend to it is the
# main outstanding task (see README).
VITE_FMP_API_KEY=your_fmp_key_here

# Server-side key used by the Express proxy in server/.
FMP_API_KEY=your_fmp_key_here
PORT=3001
